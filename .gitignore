# モデルファイル（大容量）
backend/models/
*.onnx
*.bin

# 生成されたファイル
backend/storage/
backend/storage_private/

# LANアクセス用の自己署名HTTPS証明書(端末固有の秘密鍵。generate-https-cert.ps1で生成)
backend/certs/

# KokoCloneリポジトリ（git cloneで取得するため）
backend/kokoclone/

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# Node
node_modules/
dist/
.next/

# OS
.DS_Store
Thumbs.db

# Claude Code(個人ローカル設定)
.claude/settings.local.json

# 音声ファイル(個人の声を誤ってpushしないため。モデル用の.binは上で除外済み)
*.m4a
*.mp3
*.wav
*.webm
*.aac
*.flac

# 公開用に選別した試聴音声だけは例外として含める(Pages試聴室の静的配信用。
# 声紋A/Bの変換結果のみ。本人録音そのものは絶対に置かないこと)
!frontend/public/listening/*.mp3
